# Environment variables for ScamTrapAlert backend
# Copy this file to .env and fill in your actual values (never commit .env)

# Groq API Key — https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Server port (default: 3000)
PORT=3000

# Max scans per device per day (UTC)
# Change this one value, restart backend (npm start), reload extension — limit updates everywhere
FREE_DAILY_SCAN_LIMIT=15
